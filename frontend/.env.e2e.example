# Stable Vercel preview used by default.
E2E_BASE_URL=https://choc-eride-git-deployment-vercel-baseline-kallc.vercel.app

# Use a brand-new address for the create-login test.
E2E_NEW_USER_EMAIL=replace-with-a-new-test-email@example.com

# Use a verified Firebase account for login and authenticated tests.
# This can be the same address as E2E_NEW_USER_EMAIL after verification.
E2E_TEST_EMAIL=replace-with-a-verified-test-email@example.com
E2E_TEST_PASSWORD=replace-with-a-test-password
E2E_TEST_FIRST_NAME=Automated
