{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-git-hooks": "cd .. && node .secret-scan/secret-scan.js -- --check-git-hooks",
    "format": "npm run check-git-hooks && prettier --write .",
    "lint-fix": "npm run check-git-hooks && eslint --fix --cache --report-unused-disable-directives . && prettier --write .",
    "lint-check": "npm run check-git-hooks && eslint --cache --report-unused-disable-directives . && prettier --check .",
    "test:e2e:create": "playwright test e2e/create-login.spec.ts",
    "test:e2e:login": "playwright test e2e/login.spec.ts",
    "test:e2e:happy": "playwright test e2e/authenticated-happy-path.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^16.4.7",
    "firebase": "^11.2.0",
    "html-to-image": "^1.11.13",
    "next": "15.5.9",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.5.2",
    "react-spring": "^9.7.5",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/typescript-estree": "^8.38.0",
    "eslint": "^8",
    "eslint-config-next": "^14.2.22",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "5.3.3"
  }
}
